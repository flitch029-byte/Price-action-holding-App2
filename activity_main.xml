<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOT CONTROL"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: STOPPED"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/symbol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Symbol (e.g. XAUUSD)"
            android:text="XAUUSD"
            android:inputType="text" />

        <EditText
            android:id="@+id/lot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lot size"
            android:text="0.01"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Daily target ($)"
            android:text="50"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/trailing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trailing stop (points)"
            android:text="300"
            android:inputType="number" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="START BOT" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOP BOT" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ready. This app is the control panel; live MT5 execution requires a connected MT5/VPS backend."
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
